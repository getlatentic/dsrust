# Rust build output
/target/
crates/*/target/
**/*.rs.bk

# uv-managed Python env (built by `uv sync`; .dspy-venv* are older spellings)
.venv/
.dspy-venv*/

# Python caches
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Editor / OS
.DS_Store
*.swp
*~
.idea/
.vscode/

# Local env / secrets
.env
.env.*
*.local

# Local-only comparison against other projects (never tracked)
/local-compare/

# cargo-mutants scratch trees and logs
mutants.out/
mutants.out.old/
