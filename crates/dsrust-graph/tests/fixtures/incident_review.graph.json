  "signatures": [
    {
      "id": "sig-triage",
      "name": "triageSignature",
      "docstring": "Rate the incident severity as exactly one of sev1, sev2, sev3, from customer impact and duration.",
      "inputs": [],
      "outputs": []
    },
    {
      "id": "sig-timeline",
      "name": "timelineSignature",
      "docstring": "Extract a chronological timeline of events with timestamps, one per line.",
      "inputs": [],
      "outputs": []
    },
    {
      "id": "sig-correlate",
      "name": "correlateSignature",
      "docstring": "Propose the two or three most plausible root-cause hypotheses that fit the timeline. Number them.",
      "inputs": [],
      "outputs": []
    },
    {
      "id": "sig-investigate",
      "name": "investigateSignature",
      "docstring": "Pick the single best-supported hypothesis and state the root cause in one sentence, citing the timeline evidence.",
      "inputs": [],
      "outputs": []
    },
    {
      "id": "sig-postmortem",
      "name": "postmortemSignature",
      "docstring": "Write a blameless postmortem draft — impact, timeline summary, root cause, what went well, what went poorly.",
      "inputs": [],
      "outputs": []
    },
    {
      "id": "sig-actions",
      "name": "actionsSignature",
      "docstring": "List three to five concrete, owned action items from the postmortem, one per line, each starting with a verb.",
      "inputs": [],
      "outputs": []
    }
  ],
